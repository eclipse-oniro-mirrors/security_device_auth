import("//build/ohos.gni")

# Shared test helper code for V1 sub-session tests (callbacks, session
# construction, database cleanup). Used by both integration and mock targets.
ohos_static_library("v1_test_helper") {
  subsystem_name = "security"
  testonly = true
  part_name = "device_auth"

  include_dirs = [
    ".",
    "//base/security/device_auth/interfaces/inner_api",
    "//base/security/device_auth/services/session_manager/inc/session",
    "//base/security/device_auth/services/session_manager/inc/session/v1",
    "//base/security/device_auth/services/session_manager/inc/session/v1/compatible_bind_sub_session",
    "//base/security/device_auth/services/session_manager/inc/session/v1/compatible_auth_sub_session",
    "//base/security/device_auth/test/unittest/tdd_framework/common/inc",
    "//base/security/device_auth/deps_adapter/os_adapter/interfaces",
    "//base/security/device_auth/deps_adapter/os_adapter/interfaces/linux",
  ]

  sources = [ "test_helper.cpp" ]

  cflags = [ "-DHILOG_ENABLE" ]

  external_deps = [
    "cJSON:cjson",
    "bounds_checking_function:libsec_shared",
    "hilog:libhilog",
  ]
}
