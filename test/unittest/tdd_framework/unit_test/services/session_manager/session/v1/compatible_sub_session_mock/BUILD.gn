import("//base/security/device_auth/deps_adapter/deviceauth_hals.gni")
import("//base/security/device_auth/services/deviceauth.gni")
import("//build/test.gni")

module_output_path = "device_auth/device_auth"
tdd_framework_path = "//base/security/device_auth/test/unittest/tdd_framework"
deviceauth_llt_mock_src = "//base/security/device_auth/test/unittest/deviceauth/source"

# Pure-mock target: dev_auth_module_manager is replaced by a controllable mock so
# the V1 sub-session process/finish branches (ProcessTask -> CONTINUE/FINISH/
# IGNORE_MSG/error, CreateTask fail) can be driven without a real protocol task.
ohos_unittest("compatible_sub_session_mock_test") {
  module_out_path = module_output_path

  include_dirs = inc_path + hals_inc_path
  include_dirs += [
    "${dev_frameworks_path}/inc/permission_adapter",
    "${dev_frameworks_path}/inc/hiview_adapter",
    "//base/security/device_auth/test/unittest/deviceauth/include",
    "${tdd_framework_path}/tdd_helper/exception_controller/inc",
    "${tdd_framework_path}/tdd_helper/memory_mock/inc",
    "${tdd_framework_path}/tdd_helper/memory_monitor/inc",
  ]

  sources = hal_common_files
  sources -= [ "${common_lib_path}/impl/src/json_utils.c" ]
  sources -= [ "${common_lib_path}/impl/src/hc_types.c" ]
  sources += [
    "${key_management_adapter_path}/impl/src/common/mbedtls_ec_adapter.c",
    "${key_management_adapter_path}/impl/src/huks_adapter.c",
    "${key_management_adapter_path}/impl/src/huks_adapter_utils.c",
    "${key_management_adapter_path}/impl/src/standard/crypto_hash_to_point.c",
    "${key_management_adapter_path}/impl/src/standard/huks_adapter_diff_impl.c",
    "${os_adapter_path}/impl/src/hc_err_trace.c",
    "${os_adapter_path}/impl/src/hc_log.c",
    "${os_adapter_path}/impl/src/linux/hc_condition.c",
    "${os_adapter_path}/impl/src/linux/hc_file.c",
    "${os_adapter_path}/impl/src/linux/hc_init_protection.c",
    "${os_adapter_path}/impl/src/linux/hc_thread.c",
    "${deviceauth_llt_mock_src}/hc_dev_info_mock.c",
    "${deviceauth_llt_mock_src}/json_utils_mock.c",
    "${tdd_framework_path}/tdd_helper/exception_controller/src/exception_controller.c",
    "${tdd_framework_path}/tdd_helper/memory_mock/src/memory_mock.c",
    "${tdd_framework_path}/tdd_helper/memory_monitor/src/memory_monitor.cpp",
  ]

  sources += dev_frameworks_files
  sources -= [ "${dev_frameworks_path}/src/module/dev_auth_module_manager.c" ]
  sources += [ "//base/security/device_auth/test/mock_inner/services/frameworks/module/dev_auth_module_manager_mock.c" ]
  sources += identity_service_mock_files
  sources += deviceauth_common_files
  sources += sa_load_on_demand_mock_files
  sources += group_database_manager_files
  sources += operation_database_manager_files
  sources += ext_plugin_manager_files
  sources += session_manager_files
  sources += session_mini_files
  sources += session_v1_files
  sources += session_v2_mock_files
  sources += creds_manager_files
  sources += broadcast_manager_files
  sources += soft_bus_channel_mock_files

  sources += group_auth_files
  sources -= [ "${group_auth_path}/src/group_auth_manager/group_auth_common/group_auth_data_operation.c" ]
  sources += [ "//base/security/device_auth/test/mock_inner/services/legacy/group_auth/group_auth_manager/group_auth_common/group_auth_data_operation_mock.c" ]
  sources += group_auth_account_unrelated_files
  sources += group_manager_files
  sources -= [ "${group_manager_path}/src/group_operation/group_operation_common/group_operation_common.c" ]
  sources += [ "//base/security/device_auth/test/mock_inner/services/legacy/group_manager/group_operation/group_operation_common/group_operation_common_mock.c" ]
  sources += group_manager_peer_to_peer_files
  sources += group_database_manager_files
  sources -= [ "${group_data_manager_path}/src/group_data_manager.c" ]
  sources -= [ "${group_data_manager_path}/src/group_data_manager_util.c" ]
  sources += [ "//base/security/device_auth/test/mock_inner/services/data_manager/group_data_manager/group_data_manager_mock.c" ]
  sources += authenticators_p2p_files
  sources += authenticators_p2p_iso_files
  sources += authenticators_p2p_pake_files
  sources += authenticators_standard_exchange_task_files
  sources += account_related_files
  sources += privacy_enhancement_files
  sources += mk_agree_files
  sources += security_label_adapter_files

  include_dirs += identity_manager_inc
  sources += identity_manager_files

  sources -= [
    "${authenticators_path}/src/account_unrelated/iso_task/iso_task_main.c",
    "${authenticators_path}/src/account_unrelated/pake_task/pake_v1_task/pake_v1_task_main.c",
  ]

  sources += [
    "${dev_frameworks_path}/src/account_task_manager_mock/account_task_manager_mock.c",
    "${dev_frameworks_path}/src/plugin_adapter_mock/account_auth_plugin_proxy_mock.c",
    "${deviceauth_llt_mock_src}/device_auth_ext_mock.c",
    "${deviceauth_llt_mock_src}/os_account_adapter_mock.c",
    "${deviceauth_llt_mock_src}/protocol_task_main_mock.c",
    "compatible_bind_sub_session_mock_test.cpp",
    "compatible_auth_sub_session_mock_test.cpp",
    "compatible_bind_sub_session_common_mock_test.cpp",
  ]

  defines = [
    "P2P_PAKE_DL_PRIME_LEN_384",
    "P2P_PAKE_EC_TYPE",
    "ENABLE_ACCOUNT_AUTH_ISO",
    "ENABLE_ACCOUNT_AUTH_EC_SPEKE",
    "ENABLE_P2P_BIND_ISO",
    "ENABLE_P2P_BIND_EC_SPEKE",
    "ENABLE_P2P_AUTH_ISO",
    "ENABLE_P2P_AUTH_EC_SPEKE",
    "DEV_AUTH_FUNC_TEST",
    "ENABLE_PSEUDONYM",
    "DEFAULT_V2_NOT_SUPPORT",
    "DEV_AUTH_MEMORY_DEBUG",
  ]

  cflags = [ "-DHILOG_ENABLE" ]
  cflags += [
    "-DDEV_AUTH_WORK_THREAD_STACK_SIZE=${device_auth_hichain_thread_stack_size}",
    "-DMAX_AUTH_SESSION_COUNT=${max_auth_session_count}",
  ]

  include_dirs += [
    "//base/security/device_auth/test/mock_inner/services/frameworks/module",
    "//base/security/device_auth/test/mock_inner/services/frameworks/account_task_manager_mock",
    "//base/security/device_auth/test/mock_inner/services/legacy/group_auth/group_auth_manager/group_auth_common",
    "//base/security/device_auth/test/mock_inner/services/legacy/group_auth/group_auth_mock",
    "//base/security/device_auth/test/mock_inner/services/data_manager/group_data_manager",
    "//base/security/device_auth/test/mock_inner/services/legacy/group_manager/group_operation/group_operation_common",
  ]
  sources += [ "//base/security/device_auth/test/mock_inner/services/legacy/group_auth/group_auth_mock/group_auth_mock.c" ]
  deps = []

  external_deps = [
    "cJSON:cjson",
    "bounds_checking_function:libsec_shared",
    "c_utils:utils",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "hilog:libhilog",
    "huks:libhukssdk",
    "mbedtls:mbedtls_shared",
    "openssl:libcrypto_static",
  ]
}
